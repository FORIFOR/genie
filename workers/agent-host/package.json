{
  "name": "@genie/worker-agent-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Agent Host。Dock とは別プロセスで動き、Dock を閉じても仕事を続ける。正本 §4.4・§16.1。",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@genie/contracts": "workspace:*",
    "@genie/telemetry": "workspace:*",
    "@genie/service-connectors": "workspace:*",
    "@genie/oauth": "workspace:*",
    "@genie/mcp": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
