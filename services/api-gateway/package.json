    "@genie/service-task": "workspace:*",
    "@genie/telemetry": "workspace:*",
    "@genie/tts": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "kysely": "catalog:",
    "zod": "catalog:",
    "@genie/service-share": "workspace:*",
    "@genie/service-meeting": "workspace:*",
    "@genie/service-research": "workspace:*",
    "@genie/service-world-model": "workspace:*",
