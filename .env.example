# infra/docker-compose.dev.yml の既定に合わせてある。
#   pnpm dev:infra   で PostgreSQL 16 / Redis / Temporal が上がる

# --- database ---
# アプリ用。**非 superuser・非 BYPASSRLS**（実装仕様 §4.4）
DATABASE_URL=postgres://genie_app:genie_app@localhost:5433/astra_dev?sslmode=disable
# 認証専用。identity テーブルにしか GRANT されていない BYPASSRLS ロール（§5.4）
ASTRA_DB_IDENTITY_URL=postgres://astra_identity:astra_identity@localhost:5433/astra_dev?sslmode=disable
# マイグレーションと生成物の更新に使う（dbmate / kysely-codegen）
# DATABASE_URL=postgres://astra:astra@localhost:5433/astra_dev?sslmode=disable

# 公開 viewer 専用。共有テーブルにしか GRANT されていない BYPASSRLS ロール（§5.4 / D-22）
ASTRA_DB_SHARE_URL=postgres://astra_share:astra_share@localhost:5433/astra_dev?sslmode=disable

# --- redis ---
REDIS_URL=redis://localhost:6380

# --- temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- object storage (Phase 0 dev = local filesystem adapter) ---
# 相対パスは cwd 依存。gateway と worker が同じ場所を指すよう、
# リポジトリルートから起動する（pnpm dev:gateway / pnpm dev:worker）。
ASTRA_OBJECT_STORE_ROOT=./.data/objects
# ASTRA_OBJECT_STORE=gcs
# ASTRA_GCS_BUCKET=astra-artifacts-dev

# --- plugins ---
ASTRA_BUILTIN_PLUGINS_DIR=./plugins/builtin

# --- auth ---
ASTRA_JWT_ISSUER=https://auth.astra.local
ASTRA_JWT_AUDIENCE=astra-api
ASTRA_JWT_SIGNING_KEY_ID=dev-1
# 未設定なら起動時に使い捨て鍵を作る。本番では必須（再起動で全トークンが無効になるため）
# ASTRA_JWT_PRIVATE_KEY=
# ASTRA_JWT_PUBLIC_KEY=

# --- share ---
# 公開 viewer の場所。共有リンクの組み立てに使う。
ASTRA_SHARE_HOST=http://localhost:1430
# 監査に残す requester ハッシュの salt。生の IP を残さないため（正本 §21）。
# 変わると過去のログと突き合わせられないので環境ごとに固定する。
ASTRA_REQUESTER_SALT=astra-development-salt

# --- cors ---
# ブラウザから叩けるオリジン。**既定は空**（`*` を既定にしない）。
# development / test では Vite と Tauri の webview を自動で通す。
# ASTRA_ALLOWED_ORIGINS=https://app.example.com

# --- web clients (Vite) ---
# apps/desktop と apps/share-web が接続する api-gateway
# VITE_ASTRA_API_URL=http://127.0.0.1:3000

# --- api ---
ASTRA_ENV=development
ASTRA_API_PORT=3000
# Development tokens are for this Mac only. Never expose the dev gateway to a network.
ASTRA_API_HOST=127.0.0.1
ASTRA_LOG_LEVEL=debug

# --- Reachmade product capabilities ---
# 未設定なら Genie の既存挙動は変わらず、/v1/reachmade/capabilities は空。
# Agent Team と Launchloom を同時に動かす場合は別ポートで起動し、その実URLを指定する。
# REACHMADE_AGENT_TEAM_URL=http://127.0.0.1:8787
# Agent Team を認証付き配備に接続するときだけ、製品側が受け付ける Authorization 値を明示する。
# REACHMADE_AGENT_TEAM_AUTHORIZATION=
# REACHMADE_LAUNCHLOOM_URL=http://127.0.0.1:8788
# REACHMADE_LAUNCHLOOM_TOKEN=
# localhost / 127.0.0.1 / ::1 以外は既定拒否。遠隔配備を明示的に使う場合だけ true。
# REACHMADE_ALLOW_REMOTE_CAPABILITIES=false

# --- voice (Google STT / TTS) ---
# Dock の live transcript は端末内 STT。下記を設定すると、利用者が明示的に
# 許した発話だけ Chirp 3 で確定し、Agent の返答を Google TTS で読み上げる。
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_STT_RECOGNIZER=projects/your-gcp-project/locations/us/recognizers/_
# Private same-project bucket, public access blocked, soft delete disabled, 1-day lifecycle.
# GOOGLE_STT_AUDIO_BUCKET=your-private-stt-temporary-bucket

# --- サインイン（外部の身元提供者）。§4.3
# 設定していない提供者は、サインイン画面に「使えない」と出る（ボタンは押せない）。
# Google: Desktop 用 OAuth client（PKCE、client_secret 無し）。複数はカンマ区切り
ASTRA_AUTH_GOOGLE_CLIENT_IDS=
# Apple: native は bundle id、web relay は Services ID。web relay は ASTRA_PUBLIC_URL（https）が要る
ASTRA_AUTH_APPLE_BUNDLE_ID=com.astra.desktop
ASTRA_AUTH_APPLE_SERVICE_ID=
# LINE Login channel。code の交換に channel secret が要るので relay はサーバで行う
ASTRA_AUTH_LINE_CHANNEL_ID=
ASTRA_AUTH_LINE_CHANNEL_SECRET=
# relay の折り返し先（LINE / Apple web）。ブラウザから届く公開 https
ASTRA_PUBLIC_URL=

# API / local OpenAI-compatible generation ceiling (integer 1–16384).
# An interrupted/truncated result fails visibly; it is not automatically regenerated.
# ASTRA_LLM_MAX_OUTPUT_TOKENS=4096

# Periodic email classification uses only a configured local model by default.
# Connector sync and the one-time initial profile still work without an LLM.
# Set on only to allow background sync to consume paid API/CLI model usage.
# ASTRA_WORK_SYNC_METERED_LLM=off

# Local agent host session: bootstrap once with an access/refresh pair, then omit
# both on subsequent starts. Refresh credentials rotate in this host's OS store;
# the desktop owns a separate refresh chain. Never put real tokens in this file.
# ASTRA_HOST_TOKEN=<initial access token>
# ASTRA_HOST_REFRESH_TOKEN=<initial refresh token>
# Optional thinking control for compatible local servers; no paid fallback.
# ASTRA_LOCAL_LLM_REASONING_EFFORT=none

# Explicit ASTRA_LLM_CLI values select only that route: local, codex,
# claude_code, api, or none. Unset retains automatic discovery order.
# A missing/quota-limited selected route is reported, never silently replaced.
# Local video drafts may receive at most one local revision after a concrete
# validation failure; paid/API/CLI generation is never retried automatically.

# Optional: allow longer Codex document generation (default 120000; 1000–600000 ms).
# This does not retry failed requests or change the selected model.
# ASTRA_CODEX_TIMEOUT_MS=300000