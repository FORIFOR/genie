  "validationSource": "import {parseOptions,modelConfiguration,externalScreenAllowed} from './scripts/local-preview/config.mjs';\nlet text=''; for await (const chunk of process.stdin) text+=chunk;\nconst examples=JSON.parse(text);\nfor (const example of examples) {\n const options=parseOptions([...example.args]);\n if(options.command==='start') {\n  const config=modelConfiguration({modelURL:'http://127.0.0.1:11434/v1',model:null},options);\n  if(options.allowExternalScreen===true && !externalScreenAllowed(config,options.computerUse)) throw new Error(example.file+' screen opt-in mismatch');\n  if(options.modelProvider==='codex' && options.allowExternalScreen!==true && externalScreenAllowed(config,options.computerUse)) throw new Error(example.file+' implicit screen authorization');\n  if(example.file==='docs/COMPUTER_VISION.md' && options.app!=='apps/genie-macos/build/Genie.app') throw new Error('Computer use must name the same-checkout app');\n }\n}\nparseOptions(['--no-external-screen']);\nconsole.log(JSON.stringify({status:'PASS',checkedExamples:examples.length,nodeVersion:process.version,files:[...new Set(examples.map(e=>e.file))],scope:'Pure parseOptions/modelConfiguration check only; no startup, build, model call or permission request'},null,2));\n",
